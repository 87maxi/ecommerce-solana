# --- Solana Network Configuration ---
# Endpoint del nodo Solana (Localhost por defecto para desarrollo)
# El código soporta tanto NEXT_PUBLIC_RPC_URL como NEXT_PUBLIC_SOLANA_RPC_HOST
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_SOLANA_RPC_HOST=http://127.0.0.1:8899

# --- Smart Contract Addresses ---
# Program ID del contrato de E-Commerce desplegado
NEXT_PUBLIC_ECOMMERCE_CONTRACT_ADDRESS=4ourUpEhfq64WVb1gRwR7fxkWbKZnMPmbx6D6dFwvGCq

# Dirección del Mint del token EURT (SPL Token)
# Se recomienda usar NEXT_PUBLIC_EUROTOKEN_CONTRACT_ADDRESS por consistencia con deploy.sh
NEXT_PUBLIC_EUROTOKEN_CONTRACT_ADDRESS=3BLCK7GYth8QofmLaTKjnC6GNAZ6PxJqPkUXBFHChP1d
NEXT_PUBLIC_EUROTOKEN_MINT=3BLCK7GYth8QofmLaTKjnC6GNAZ6PxJqPkUXBFHChP1d

# --- Integración con Servicios Externos ---
# URL del servicio de compra de tokens (compra-stablecoin - Puerto 3033)
NEXT_PUBLIC_COMPRA_STABLECOIN_URL=http://localhost:3033
# Variante con errata generada por deploy.sh (mantenida por compatibilidad)
NEXT_PUBLIC_COMPRAS_STABLEBOIN_URL=http://localhost:3033

# URL de la pasarela de pagos para el checkout (pasarela-de-pago - Puerto 3034)
NEXT_PUBLIC_PASARELA_PAGO_URL=http://localhost:3034

# URL base de esta aplicación (Web Customer - Puerto 3030)
NEXT_PUBLIC_SITE_URL=http://localhost:3030
