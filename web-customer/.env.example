# Variables de entorno para web-customer
# Asegúrate de que estas variables coincidan con tu configuración local de Solana (Surfpool).

# RPC Host para la conexión a la red de Solana (ej. localnet, devnet)
# Usamos el host RPC configurado en .env o el fallback de clusterApiUrl
NEXT_PUBLIC_SOLANA_RPC_HOST=http://127.0.0.1:8899

# Program ID del E-Commerce desplegado en tu red local
NEXT_PUBLIC_ECOMMERCE_CONTRACT_ADDRESS=4ourUpEhfq64WVb1gRwR7fxkWbKZnMPmbx6D6dFwvGCq

# Dirección del Mint del token EURT en tu red local
NEXT_PUBLIC_EUROTOKEN_CONTRACT_ADDRESS=AKWdemYgbmSujB1jTMm8q6q3fKTtcxr5XXp8tSSoDekC
NEXT_PUBLIC_EUROTOKEN_MINT=AKWdemYgbmSujB1jTMm8q6q3fKTtcxr5XXp8tSSoDekC

# URL base de la aplicación de pago/compra de stablecoins (donde el usuario es redirigido)
NEXT_PUBLIC_COMPRAS_STABLEBOIN_URL=http://localhost:3032

# URL base de la aplicación principal del cliente para redirecciones
NEXT_PUBLIC_SITE_URL=http://localhost:3030
