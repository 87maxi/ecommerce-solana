# Variables de entorno para la aplicación de Compra de Stablecoin (EURT)

# URL del endpoint RPC de Solana. Para desarrollo local, suele ser http://127.0.0.1:8899
# Si no se especifica, usa el que viene por defecto de @solana/wallet-adapter-base
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899

# Clave publicable de Stripe (necesaria para el checkout de tarjeta de crédito, aunque ahora usamos wallet)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YourPublishableKey

# Dirección del Mint del token EuroToken (EURT) en la red configurada
# Asegúrate de que esta sea la dirección correcta del token en tu red (local o devnet)
NEXT_PUBLIC_EUROTOKEN_CONTRACT_ADDRESS=AKWdemYgbmSujB1jTMm8q6q3fKTtcxr5XXp8tSSoDekC

# URL base de la aplicación del cliente web (para redirecciones post-compra)
NEXT_PUBLIC_WEB_CUSTOMER_URL=http://localhost:3030
